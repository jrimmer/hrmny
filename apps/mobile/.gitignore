# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (all of them: a plain `apps/mobile/.env` — read by Expo and
# by EAS' project archive — must never be committed). The example is the one
# deliberate exception, mirroring the root .gitignore.
.env*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
